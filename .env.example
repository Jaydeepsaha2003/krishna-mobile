# =============================================================================
# Krishna Mobile — environment
# Copy this file to `.env` and fill in the values BEFORE running `npm run build:win`.
# The `.env` is bundled into the installer, so the end user never configures anything.
# =============================================================================

# --- Turso (libSQL) ----------------------------------------------------------
# Get these with:
#   turso db create krishna-mobile
#   turso db show krishna-mobile --url
#   turso db tokens create krishna-mobile
TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Embedded replica: keeps a local SQLite copy so the shop keeps working (reads)
# when the internet drops, and syncs to Turso when it is back.
# Set to "false" to talk to Turso directly over HTTP with no local copy.
TURSO_EMBEDDED_REPLICA=true

# How often (seconds) the local replica pulls from Turso. 0 = manual only.
TURSO_SYNC_INTERVAL=30

# --- Defaults seeded on first run -------------------------------------------
# The built-in administrator. PIN must be exactly 6 digits.
DEFAULT_ADMIN_NAME=Administrator
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PIN=202600

# First company + shops created automatically on a fresh database.
DEFAULT_COMPANY_NAME=Krishna Mobile
DEFAULT_COMPANY_STATE=Maharashtra
DEFAULT_SHOP_1_NAME=Shop 1
DEFAULT_SHOP_2_NAME=Shop 2

# --- Auto update -------------------------------------------------------------
# Leave BLANK to use the GitHub Releases feed configured in electron-builder.yml.
# Set it only if you host updates yourself: the folder holding latest.yml,
# the setup .exe and the .blockmap.
UPDATE_FEED_URL=
# Check for updates every N minutes while the app is running.
UPDATE_CHECK_INTERVAL_MINUTES=60
# "auto"   -> download + install + relaunch on its own (quiet, on quit or forced)
# "notify" -> download, then ask the user before relaunching
UPDATE_MODE=auto
